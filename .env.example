# Required for catalogue, accounts, orders and admin data. MongoDB transactions need a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/rf-riddhy?replicaSet=rs0
MONGODB_DB=rf-riddhy
JWT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeded local demo administrator. Change both before sharing a deployment.
DEMO_ADMIN_EMAIL=admin@riddhy.in
DEMO_ADMIN_PASSWORD=RiddhyDemo!2026

# Razorpay (leave blank to keep online payment disabled locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary (optional; claim photo/video uploads are disabled when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional; email notifications are skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RF Riddhy <noreply@riddhy.in>"

# Storage & Uploads
UPLOAD_DIR=storage/uploads
UPLOAD_STORAGE=local

