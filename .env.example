# Required for catalogue, accounts, orders and admin data. MongoDB transactions need a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/rf-riddhy?replicaSet=rs0
MONGODB_DB=rf-riddhy
JWT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seeded local demo administrator. Change both before sharing a deployment.
DEMO_ADMIN_EMAIL=admin@riddhy.in
DEMO_ADMIN_PASSWORD=RiddhyDemo!2026

# Razorpay (leave blank to keep online payment disabled locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary (optional; claim photo/video uploads are disabled when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional; email notifications are skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RF Riddhy <noreply@riddhy.in>"

# Storage & Uploads
UPLOAD_DIR=storage/uploads
UPLOAD_STORAGE=local

# Company, Tax & Invoicing
COMPANY_LEGAL_NAME="RF Riddhy Furniture & Appliances Pvt Ltd"
COMPANY_TRADE_NAME="RF Riddhy"
COMPANY_GSTIN="07AAAAA0000A1Z5"
COMPANY_PAN="AAAAA0000A"
COMPANY_STATE="Delhi"
COMPANY_STATE_CODE="07"
COMPANY_ADDRESS_LINE1="Plot 42, Okhla Industrial Area Phase III"
COMPANY_CITY="New Delhi"
COMPANY_PINCODE="110020"
COMPANY_PHONE="+91 98765 43210"
COMPANY_EMAIL="billing@rfriddhy.com"
INVOICE_PREFIX=RF
INVOICE_TIMING=paid
DEFAULT_WAREHOUSE_CODE=DELHI-01
STORE_CURRENCY=INR

